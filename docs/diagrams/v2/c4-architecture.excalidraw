      "seed": 7880906,
      "version": 2,
      "versionNonce": 623402390,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791171324072,
      "link": null,
      "locked": false,
      "text": "LLM_MODE se cambia con una variable y solo lo conoce llm_gateway: fake (por defecto) reproduce las 140 respuestas auténticas de los 4 demos; ollama usa los modelos; record los usa y\ngraba, y make record promueve por guion solo si el demo llegó a su resultado.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM_MODE se cambia con una variable y solo lo conoce llm_gateway: fake (por defecto) reproduce las 140 respuestas auténticas de los 4 demos; ollama usa los modelos; record los usa y\ngraba, y make record promueve por guion solo si el demo llegó a su resultado.",
      "autoResize": true,
      "lineHeight": 1.15
    },
