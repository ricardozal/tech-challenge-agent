    {
      "id": "d2:e1",
      "type": "text",
      "x": 60,
      "y": 1792,
      "width": 1835.0869140625,
      "height": 19.549999999999997,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "d2:frame",
      "index": "b08",
      "roundness": null,
      "seed": 379320598,
      "version": 2,
      "versionNonce": 1937103498,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791171324072,
      "link": null,
      "locked": false,
      "text": "Siete contenedores en docker compose y Ollama en el host. El agente actúa solo por la Case Actions API e infiere solo por el LLM Gateway; la misma capa de acciones sirve al agente y al asesor. Fronteras verificadas con tests de arquitectura.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Siete contenedores en docker compose y Ollama en el host. El agente actúa solo por la Case Actions API e infiere solo por el LLM Gateway; la misma capa de acciones sirve al agente y al asesor. Fronteras verificadas con tests de arquitectura.",
      "autoResize": true,
      "lineHeight": 1.15
    },
