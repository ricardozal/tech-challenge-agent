    {
      "id": "d6:e42",
      "type": "text",
      "x": 90,
      "y": 12420.85,
      "width": 523.828125,
      "height": 162,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "d6:trace:g"
      ],
      "frameId": "d6:frame",
      "index": "b8R",
      "roundness": null,
      "seed": 466817546,
      "version": 2,
      "versionNonce": 773445718,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791171324072,
      "link": null,
      "locked": false,
      "text": "turn ......................... AGENT  session.id = id del caso · entrada y salida redactadas\n├─ documents ................. CHAIN  nodo de LangGraph (sin el estado del turno)\n│  ├─ append_message ......... TOOL   entrada redactada · desenlace\n│  └─ submit_document ........ TOOL   ERROR si se rechaza (código de rechazo)\n│     └─ read_document ....... CHAIN  doc_intel: tipo detectado y confianza por campo\n│        ├─ ocr → glm-ocr .... LLM    tokens · latencia · replay y origen en fake\n│        └─ extract → gemma4 . LLM    un span por intento; el inválido en ERROR\n└─ respond ................... CHAIN\n   └─ reply → gemma4:12b ..... LLM    respuesta redactada",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "turn ......................... AGENT  session.id = id del caso · entrada y salida redactadas\n├─ documents ................. CHAIN  nodo de LangGraph (sin el estado del turno)\n│  ├─ append_message ......... TOOL   entrada redactada · desenlace\n│  └─ submit_document ........ TOOL   ERROR si se rechaza (código de rechazo)\n│     └─ read_document ....... CHAIN  doc_intel: tipo detectado y confianza por campo\n│        ├─ ocr → glm-ocr .... LLM    tokens · latencia · replay y origen en fake\n│        └─ extract → gemma4 . LLM    un span por intento; el inválido en ERROR\n└─ respond ................... CHAIN\n   └─ reply → gemma4:12b ..... LLM    respuesta redactada",
      "autoResize": true,
      "lineHeight": 1.2
    },
